generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                         @id @default(cuid()) @map("_id")
  nick          String?
  name          String?
  lastName      String?
  password      String?
  email         String?                        @unique
  image         String?
  emailVerified DateTime?
  acceptTerms   Boolean?
  eneabled      Boolean?
  accounts      Account[]
  sessions      Session[]
  cssSolutions  CssAssignmentSolution[]
  solutions     JavascriptAssignmentSolution[]

  @@map("users")
}

model JavascriptAssignment {
  id               String                         @id @default(cuid())
  name             String
  category         Category                       @default(FUNCTION)
  difficultyLevel  DifficultyLevel                @default(EASY)
  submissions      Int?                           @default(0)
  descriptionStart String
  descriptionEnd   String?
  sampleInput      String[]
  sampleOutput     String[]
  tests            Json[]
  patternFunction  String
  solutions        JavascriptAssignmentSolution[]
}

model JavascriptAssignmentSolution {
  id                     String               @id @default(cuid())
  javascriptAssignment   JavascriptAssignment @relation(fields: [javascriptAssignmentId], references: [id])
  javascriptAssignmentId String
  solution               Json[]               @default([])
  user                   User                 @relation(fields: [userId], references: [id])
  userId                 String

  @@unique([javascriptAssignmentId, userId])
}

model CssAssignment {
  id                String              @id @default(cuid()) @map("_id")
  name              String
  description       String
  code              String
  category          CssCategory
  difficultyLevel   DifficultyLevel
  requirements      Int
  colors            String[]
  solutions         CssAssignmentSolution[]
  targetUrl         String
}

model CssAssignmentSolution {
  id              String         @id @default(cuid()) @map("_id")
  cssAssignment   CssAssignment  @relation(fields: [CssAssignmentId], references: [id])
  CssAssignmentId String
  solution        String
  user            User           @relation(fields: [userId], references: [id])
  userId          String
  result          Int            @default(0)

  @@unique([CssAssignmentId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Category {
  FUNCTION
  LOOP
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum CssCategory {
  SHAPES
}